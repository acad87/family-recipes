      "id": "eab1235e-9a9b-59d5-b662-9564ad0fda5b",
      "name": "List subfolder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "rcpGoogleDrive001",
          "name": "Google Drive"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const IMG = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];\nconst groups = $('Is a subfolder?').all(0);\nreturn $input.all().map((it, i) => {\n  const g = groups[i].json;\n  const files = (it.json.files || []).filter(f => IMG.includes(f.mimeType))\n    .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));\n  return { json: { ...g, files } };\n}).filter(x => x.json.files.length > 0);"
      },
