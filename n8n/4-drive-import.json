        440,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "rcpGoogleDrive001",
          "name": "Google Drive"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const IMG = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];\nconst FOLDER = 'application/vnd.google-apps.folder';\nconst files = $json.files || [];\nconst out = [];\nfor (const f of files) {\n  if (f.mimeType === FOLDER) out.push({ json: { ref: f.id, name: f.name, kind: 'folder', files: [] } });\n  else if (IMG.includes(f.mimeType)) out.push({ json: { ref: f.id, name: f.name, kind: 'file', files: [f] } });\n}\nreturn out;"
      },
