    {
      "parameters": {
        "jsCode": "const known = new Set($input.all().map(i => i.json.source_ref).filter(Boolean));\nconst max = Number($('Settings').first().json.max_recipes) || 5;\nconst todo = $('All recipes').all().map(i => i.json).filter(g => !known.has(g.ref));\nconsole.log(`${todo.length} new recipe(s) found; importing up to ${max} this run.`);\nreturn todo.slice(0, max).map(g => ({ json: g }));"
      },
