      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "rcpSupabaseKey001",
          "name": "Supabase secret key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const g = $('When called').first().json;\nconst paths = $('One item per screenshot').all().map(i => i.json.path);\nif ($input.all().length !== paths.length) throw new Error('Not every screenshot uploaded');\nreturn [{ json: { source: 'drive', status: 'processing', images: paths, source_ref: g.ref, texts: [] } }];"
      },
