    {
      "parameters": {
        "jsCode": "const g = $('When called').first().json;\nconst ext = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/gif': 'gif' };\nreturn (g.files || []).map((f, i) => ({ json: {\n  file_id: f.id, mime: f.mimeType,\n  path: `drive/${g.ref}/${String(i + 1).padStart(2, '0')}-${f.id}.${ext[f.mimeType] || 'jpg'}`,\n} }));"
      },
      "id": "d77850db-3f7e-597b-8c5b-19f01afd7a09",
      "name": "One item per screenshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
