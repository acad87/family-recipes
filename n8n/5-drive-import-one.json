        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.drive_api }}/drive/v3/files/{{ $json.file_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "alt",
              "value": "media"
            },
            {
              "name": "supportsAllDrives",
