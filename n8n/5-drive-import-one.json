      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return ($('When called').first().json.notes || []).slice(0, 3).map(n => ({ json: n }));"
      },
      "id": "e64b52e3-b307-5848-a0fb-f9e16d1ded3a",
      "name": "One item per note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.drive_api }}/drive/v3/files/{{ $json.id }}{{ $json.mimeType === 'application/vnd.google-apps.document' ? '/export?mimeType=text/plain' : '?alt=media' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "text"
            }
          }
        }
      },
      "id": "ca457d99-4276-504a-a39f-374b8ee830de",
      "name": "Read note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        160
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "rcpGoogleDrive001",
          "name": "Google Drive"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Runs once for the whole recipe, whichever way it was reached\nconst g = $('When called').first().json;\nconst ext = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/gif': 'gif' };\nreturn (g.files || []).map((f, i) => ({ json: {\n  file_id: f.id, mime: f.mimeType,\n  path: `drive/${g.ref}/${String(i + 1).padStart(2, '0')}-${f.id}.${ext[f.mimeType] || 'jpg'}`,\n} }));"
      },
      "id": "750d3a72-d175-5f17-a857-f7842965d97c",
      "name": "One item per screenshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.drive_api }}/drive/v3/files/{{ $json.file_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "alt",
              "value": "media"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "cbaf3147-b346-5349-9863-703821408aa3",
      "name": "Download from Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "rcpGoogleDrive001",
          "name": "Google Drive"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.supabase_url }}/storage/v1/object/recipe-images/{{ $('One item per screenshot').item.json.path }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "={{ $('One item per screenshot').item.json.mime }}"
            },
            {
              "name": "x-upsert",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "id": "8640f688-d28c-5277-b71c-2772b15525dd",
      "name": "Upload to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "rcpSupabaseKey001",
          "name": "Supabase secret key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const g = $('When called').first().json;\nconst paths = $('One item per screenshot').all().map(i => i.json.path);\nif ($input.all().length !== paths.length) throw new Error('Not every screenshot uploaded');\nlet texts = [];\ntry {\n  texts = $('Read note').all()\n    .map(i => String(i.json.text || '').trim())\n    .filter(t => t && !/^\\{\"error\"/.test(t))\n    .map(t => t.slice(0, 4000));\n} catch (e) { /* no note in this recipe */ }\nreturn [{ json: { source: 'drive', status: 'processing', images: paths, source_ref: g.ref, texts } }];"
      },
      "id": "e7dccc75-a880-59b7-ac42-59e40d29320a",
      "name": "Collect paths",
